# ─── GCP / Secret Manager ────────────────────────────────────────────────────
# Set GCP_PROJECT_ID to enable Secret Manager lookups.
# Omit it to fall back to the explicit env vars below (recommended for local dev).
GCP_PROJECT_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION_STRING=mongodb://localhost:27017
DB_NAME=weather

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_key_for_local_development_only
JWT_EXPIRATION=3600000
JWT_AUDIENCE=weatherify-app
JWT_ISSUER=weatherify-backend
JWT_REALM=jwt-realm

# ─── Weather API (OpenWeatherMap) ─────────────────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_URL=https://api.openweathermap.org/data/3.0/onecall
AIR_POLLUTION_URL=https://api.openweathermap.org/data/2.5/air_pollution

# ─── Razorpay Payments ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Weatherify

# ─── Firebase Push Notifications ─────────────────────────────────────────────
# Either set this to the path of your serviceAccountKey.json file,
# or configure the firebase-service-account-key secret in GCP Secret Manager.
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ─── Redis ────────────────────────────────────────────────────────────────────
# Leave blank to disable Redis caching (in-memory fallback used instead).
REDIS_URL=redis://localhost:6379

# ─── Analytics (GA4) ──────────────────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your_ga4_api_secret_here
GA_ENABLED=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Atlassian OAuth 2.0 (3LO) — bot middleware (APE-10) ─────────────────────
# Shared service-account OAuth. Bots call /bot/atlassian/* only; tokens never leave middleware.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=https://your-api.example.com/admin/atlassian/oauth/callback
ATLASSIAN_OAUTH_REFRESH_TOKEN=
# Shared secret for /bot/atlassian/* (Authorization: Bearer or X-Bot-Token).
# Secret Manager key: bot-atlassian-shared-secret
BOT_ATLASSIAN_SHARED_SECRET=dummy_bot_atlassian_shared_secret
ATLASSIAN_BASE_URL=https://androidplay.atlassian.net
ATLASSIAN_CLOUD_ID=5dc5cb59-3451-414c-9239-406e9ae97a96
ATLASSIAN_DEFAULT_PROJECT=APE
# Optional localhost bootstrap redirect — ONLY allowlisted when this env is explicitly set
# (not auto-added). Leave unset in production.
# ATLASSIAN_OAUTH_LOCALHOST_REDIRECT=http://localhost:8080/admin/atlassian/oauth/callback
